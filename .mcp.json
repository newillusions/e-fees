{
  "$schema": "https://modelcontextprotocol.io/schema/mcp-config.schema.json",
  "mcpServers": {
    "SurrealDB": {
      "command": "/Users/martin/.claude/scripts/mcp-with-creds.sh",
      "args": ["/Users/martin/.cargo/bin/surrealmcp", "start"],
      "env": {
        "SURREALDB_URL_FROM": "EFEES_SURREALDB_URL",
        "SURREALDB_NS_FROM": "EFEES_SURREALDB_NS",
        "SURREALDB_DB_FROM": "EFEES_SURREALDB_DB",
        "SURREALDB_USER_FROM": "EFEES_SURREALDB_USER",
        "SURREALDB_PASS_FROM": "EFEES_SURREALDB_PASS"
      }
    },
    "tauri-mcp": {
      "command": "node",
      "args": ["/Volumes/base/dev/claude/e-fees/tauri-plugin-mcp/mcp-server-ts/build/index.js"]
    },
    "desktop-commander": {
      "command": "npx",
      "args": ["-y", "@wonderwhy-er/desktop-commander"]
    },
    "github": {
      "command": "/Users/martin/.claude/scripts/mcp-with-creds.sh",
      "args": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "env": {}
    },
    "document-loader": {
      "command": "uvx",
      "args": ["awslabs.document-loader-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "excel": {
      "command": "uvx",
      "args": ["excel-mcp-server", "stdio"]
    },
    "peekaboo": {
      "command": "npx",
      "args": ["-y", "@steipete/peekaboo-mcp"]
    },
    "indesign": {
      "command": "node",
      "args": ["/Volumes/base/dev/indesign-uxp-server/src/index.js"]
    }
  }
}
