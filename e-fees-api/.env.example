SURREAL_URL=ws://10.0.23.11:8000
SURREAL_NS=emittiv
SURREAL_DB=projects
SURREAL_USER=martin
SURREAL_PASS=
API_KEY=
API_PORT=3200

# Optional: enables Nextcloud folder-creation / document-upload / rescan
# features (src/ssh.rs, src/routes/folders.rs, src/routes/documents.rs).
# If NC_SSH_HOST is unset, those endpoints are disabled (folder_config = None)
# rather than erroring - see config.rs.
# Defaults shown below are config.rs's fallback values when the var is unset
# (NC_SSH_HOST has no default - its absence is what disables the feature).
NC_SSH_HOST=
NC_SSH_USER=root
NC_SSH_KEY=/root/.ssh/id_ed25519
NC_SCRIPT_PATH=/mnt/user/appdata/scripts/nc-project-create.sh
NC_BASE_PATH=/mnt/user/emittiv/nc/__groupfolders/1/01 Projects
NC_OWNER=99:100
